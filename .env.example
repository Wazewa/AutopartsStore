#== POSTGRES_SQL ==#
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autopartsstore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

#== JWT ==#

JWT_SECRET=default-dev-secret-key-at-least-32-chars
JWT_ACCESS_TTL=900000
JWT_REFRESH_TTL=604800000

#== SPRING ==#

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/your-database
SPRING_DATASOURCE_USERNAME=your-name
SPRING_DATASOURCE_PASSWORD=your-password

